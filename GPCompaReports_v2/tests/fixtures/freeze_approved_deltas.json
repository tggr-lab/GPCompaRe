    {
      "id": "methods-homozygote-statement",
      "approved_on": "2026-10-19",
      "approved_by": "Yamir (scope \"Additions + text fixes\", database brief 2026-10-19)",
      "section": "sec-methods",
      "what": "The Het count sentence in Methods.",
      "why": "It said homozygote counts are uniformly zero. They are not: 789 of the 29,213 alleles in the site's variant tables (3,621 of 145,345 alleles in the Studio's full gnomAD v4.1 pack) have ac_hom > 0. het_count = ac - 2 * ac_hom for every row.",
      "kind": "literal",
      "after": "The Het count column shows heterozygote allele counts (allele count minus twice the homozygote count); homozygote counts are not shown.",
      "before": "The Het count column shows heterozygote allele counts; homozygote counts are uniformly zero across these rare missense variants in the current gnomAD v4 snapshot and are omitted."
    },
