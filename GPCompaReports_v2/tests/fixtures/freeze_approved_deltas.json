      "id": "threshold-label-two-decimals",
      "approved_on": "2026-10-19",
      "approved_by": "Yamir (scope \"Additions + text fixes\", database brief 2026-10-19)",
      "section": "sec-distribution",
      "what": "The Medium and Low magnitude labels print the receptor threshold with two decimals instead of one.",
      "why": "\"%.1f\" showed ADRB2's 1.97 as 2.0 while Methods says 1.97, and pairs between 1.97 and 2.0 are counted as Medium. Displayed text only; counts unchanged.",
      "kind": "literal_per_receptor",
      "derivation": "values[gpcr_id] = [\"%.2f\" % t, \"%.1f\" % t] with t = _calc_significance_threshold(delta_df) from gpcr_report_helpers.py, on the batch run 20260202_151051. Per receptor, because the one-decimal label cannot be recomputed from the two-decimal one (12 receptors double-round differently, e.g. 5ht4r 2.2538 -> \"2.25\" -> 2.2 but was \"2.3\", and 2.35 / 2.65 map to different originals in different receptors).",
      "templates": [
        [
          "Medium ({after} ≤ |Δ| &lt; 5.0)",
          "Medium ({before} ≤ |Δ| &lt; 5.0)"
        ],
        [
          "Low (|Δ| &lt; {after})",
          "Low (|Δ| &lt; {before})"
        ]
